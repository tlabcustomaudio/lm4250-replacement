	(text "LM4250 CLONE - discrete transistor-level replica of the National/TI LM4250 programmable op-amp (AN-71 fig. 1)" (exclude_from_sim no) (at 101.6 78.74 0) (effects (font (size 2.5 2.5) (thickness 0.3) bold) (justify left bottom)) (uuid "702d4ef6-ef12-40f6-9eaf-3d7dcb7d3e9a"))
	(text "Pin 8 (ISET): resistor to V- sets the bias (Rset = (V+ - 0.5 V) / Iset). Stingray-style preamp: 1M5 at 9 V = 5.7 uA -> GBW ~200 kHz, slew ~0.11 V/us." (exclude_from_sim no) (at 101.6 85.09 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "9a85cfae-3316-4ae8-9c52-bea1d701dad0"))
	(text "Parts are numbered AN-71 number + 100 (Q101..Q118, R101..R117, C101): they never clash with the host pedal's R7, C6 ..." (exclude_from_sim no) (at 101.6 95.25 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "6804a1f9-9990-4ae9-a554-8f12df421b2b"))
	(text "Cc 39 pF (the original 30 pF; 39-40 p tracks the datasheet GBW/slew graphs for Iset 1-20 uA at 9 V and 18 V in simulation) - tune on the bench.  Single supply: V- = GND." (exclude_from_sim no) (at 101.6 90.17 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "7a253fb1-4ca0-45bb-8f3d-ae466a3d2ff5"))
	(text "A = V+ through R108 (100R)" (exclude_from_sim no) (at 143.28 101.5 0) (effects (font (size 1.3 1.3)) (justify left bottom)) (uuid "465b1798-7864-49b5-935f-c613e29ce1b3"))
	(text "BIAS" (exclude_from_sim no) (at 136.28 101.5 0) (effects (font (size 1.6 1.6) (thickness 0.3) bold) (justify left bottom)) (uuid "97b543bb-a1f2-4524-a8f3-6559f1df69da"))
	(text "INPUT PAIR (lateral PNP, 10k degeneration)" (exclude_from_sim no) (at 131.28 139.5 0) (effects (font (size 1.6 1.6) (thickness 0.3) bold) (justify left bottom)) (uuid "98b42c6f-dcf5-44c6-8cee-d72ab4e7b6ef"))
	(text "SECOND STAGE + Miller cap (Cc)" (exclude_from_sim no) (at 211.28 139.5 0) (effects (font (size 1.6 1.6) (thickness 0.3) bold) (justify left bottom)) (uuid "21fef215-2dee-4fe6-852d-18ac8dbb189e"))
	(text "OUTPUT STAGE" (exclude_from_sim no) (at 271.28 106.5 0) (effects (font (size 1.6 1.6) (thickness 0.3) bold) (justify left bottom)) (uuid "b4b7d170-1351-444e-89de-6ccc9b2a6a3a"))
	(text "DIP-8 pins: 1 NULL, 2 IN-, 3 IN+, 4 V-, 5 NULL, 6 OUT, 7 V+, 8 ISET" (exclude_from_sim no) (at 95.28 191.5 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "e11fdc4a-26a9-49d2-9386-62a29021ff6b"))
	(text "Offset null pins 1/5 (emitters of Q4/Q3) are brought out as on the original.  Rset (pin 8 to V-) is external." (exclude_from_sim no) (at 95.28 195.5 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "f6796b5d-a8e8-41e0-b909-78fd15496960"))
